{
	"format_version": "1.26.50",
	"minecraft:entity": {
		"description": {
			"identifier": "syroy:wombat",
			"spawn_category": "creature",
			"is_spawnable": true,
			"is_summonable": true,
			"properties": {
				"syroy:sleeping": { "type": "bool", "default": false, "client_sync": true },
				"syroy:disturbed": { "type": "bool", "default": false, "client_sync": false }
			}			
		},
		"component_groups": {
			"syroy:wombat_sleeping": {
				"minecraft:movement": { "value": 0 },
				"minecraft:entity_sensor": {
					"relative_range": false,
					"subsensors": [
						{
							"range": [6, 6],
							"minimum_count": 1,
							"event_filters": {
								"any_of": [
									{ "test": "is_family", "subject": "other", "value": "player" },
									{ "test": "is_family", "subject": "other", "value": "zombie" }
								]
							},
							"event": "syroy:disturbed"
						}
					]
				},
				"minecraft:on_hurt": {
					"event": "syroy:disturbed",
					"target": "self"
				}				
			},
			"syroy:wombat_alert": {
				"minecraft:timer": {
					"time": 15,
					"looping": false,
					"time_down_event": { "event": "syroy:calm_down", "target": "self" }
				}
			},			
			"syroy:wombat_baby": {
				"minecraft:is_baby": {},
				"minecraft:scale": {"value": 0.5},
				"minecraft:ageable": {
					"duration": 1800,
					"feed_items": [
						"minecraft:mangrove_roots",
						"minecraft:hanging_roots",
						"minecraft:fern"
					],
	          		"pause_growth_items": [ "golden_dandelion" ],
          			"reset_growth_items": [ "golden_dandelion" ],
					"grow_up": {
						"event": "minecraft:ageable_grow_up",
						"target": "self"
					}
				}										
			},
			"syroy:wombat_adult": {
				"minecraft:experience_reward": {
					"on_bred": "Math.Random(1,6)",
					"on_death": "query.last_hit_by_player ? Math.Random(1,3) : 0"
				},
				"minecraft:loot": {
				"table": "loot_tables/wombat.json"
				},
				"minecraft:breedable": {
					"require_tame": true,
					"require_full_health": true,
					"breeds_with": {
						"syroy:wombat": {}
					},
					"breed_items": ["wheat"]
				}									
			},
			"syroy:wombat_wild": {
				"minecraft:tameable": {
					"probability": 0.33,
					"tame_items": ["cookie"],
					"tame_event": {
						"event": "minecraft:on_tame",
						"target": "self"
					}
				},
				"minecraft:behavior.ram_attack": {
						"priority": 2,
						"run_speed": 0.7,
						"ram_speed": 1.5,
						"min_ram_distance": 1,
						"ram_distance": 10,
						"knockback_force": 0.6,
						"knockback_height": 0.05,
						"cooldown_range": {
							"min": 8,
							"max": 12
						},
						"pre_ram_sound": "pre_ram",
						"ram_impact_sound": "ram_impact"
				},
				"minecraft:behavior.melee_attack": {
				"priority": 3,
				"speed_multiplier": 1.2,
				"track_target": true,
				"reach_multiplier": 1.5
				},
				"minecraft:behavior.nearest_attackable_target": {
					"priority": 4,
					"entity_types": [
						{
							"filters": {
								"any_of": [
									{ "test": "is_family", "subject": "other", "value": "player" },
									{ "test": "is_family", "subject": "other", "value": "zombie" }
								]
							},
							"max_dist": 16
						}
					]
				},					
				"minecraft:behavior.hurt_by_target": {
					"priority": 1
				}
			},

			"syroy:wombat_tame": {
				"minecraft:is_tamed": {},
				"minecraft:sittable": {},
				"minecraft:behavior.stay_while_sitting": {
					"priority": 0
				},
				"minecraft:behavior.follow_owner": {
					"priority": 5,
					"speed_multiplier": 1.2,
					"start_distance": 10,
					"stop_distance": 2
				},
				"minecraft:behavior.owner_hurt_by_target": {
					"priority": 1
				},
				"minecraft:behavior.hurt_by_target": {
					"priority": 2
				},
				"minecraft:behavior.ram_attack": {
					"priority": 2,
					"run_speed": 0.7,
					"ram_speed": 1.5,
					"min_ram_distance": 1,
					"ram_distance": 10,
					"knockback_force": 0.6,
					"knockback_height": 0.05,
					"cooldown_range": {
						"min": 4,
						"max": 8
					},
					"pre_ram_sound": "pre_ram",
					"ram_impact_sound": "ram_impact"
				},
				"minecraft:behavior.melee_attack": {
					"priority": 3,
					"speed_multiplier": 1.2,
					"track_target": true,
					"reach_multiplier": 1.5
				},				
				"minecraft:behavior.melee_box_attack": {
					"priority": 4
				},					
				"minecraft:behavior.breed": {
					"priority": 4,
					"speed_multiplier": 1.0
				}						
			}
		},
		"components": {
			"minecraft:is_hidden_when_invisible": {},
      		"minecraft:nameable": {},
			"minecraft:spawn_egg_interaction": {},
	      	"minecraft:type_family": {
        		"family": [ "wombat", "mob" ]
      		},
			"minecraft:offspring": {
				"offspring_pairs": {
				"syroy:wombat": "syroy:wombat"
				}
			},
			"minecraft:ambient_sound_interval": {
			"value": 8,
			"range": 4,
			"event_name": "ambient"
			},						
			"minecraft:breathable": {
        		"total_supply": 15,
        		"suffocate_time": 3,
				"inhale_time": 5
      		},
			"minecraft:collision_box": {
				"width": 0.8,
				"height": 0.8
			},
			"minecraft:leashable": {},
			"minecraft:despawn": {
				"despawn_from_distance": {}
			},
			"minecraft:health": {
				"value": 8,
				"max": 8
			},
			"minecraft:hurt_on_condition": {
				"damage_conditions": [
				{
					"filters": {
					"test": "in_lava",
					"subject": "self"
					},
					"cause": "lava",
					"damage_per_tick": 4
				}
				]
			},						
			"minecraft:navigation.walk": {
				"can_path_over_water": true,
				"avoid_damage_blocks": true
			},
			"minecraft:movement": { "value": 0.15 },
			"minecraft:movement.basic": {},
			"minecraft:jump.static": {},
			"minecraft:can_climb": {},
			"minecraft:attack": {
				"damage": 5
			},
			"minecraft:healable": {
				"items": [
					{
						"item": "cookie",
						"heal_amount": 6
					}
				]
			},
			"minecraft:physics": {},
			"minecraft:pushable_by_entity": {},
			"minecraft:pushable_by_block": {},			
			
			"minecraft:behavior.float": {
        		"priority": 2,
				"sink_with_passengers": true
      		},			
			"minecraft:behavior.panic": {
				"priority": 3,
				"speed_multiplier": 1.25
			},			
			"minecraft:behavior.tempt": {
				"priority": 5,
				"speed_multiplier": 1.2,
				"items": [
				"cookie"
				]
			},
			"minecraft:behavior.random_stroll": {
				"priority": 7,
				"speed_multiplier": 1.0
			},
			"minecraft:behavior.look_at_player": {
				"priority": 8,
				"look_distance": 6.0,
				"probability": 0.02
			},
			"minecraft:behavior.random_look_around": {
				"priority": 9
			},		
			"minecraft:environment_sensor": {
				"triggers": [
				{
					"filters": { "all_of": [
						{ "test": "is_daytime", "value": false },
						{ "test": "bool_property", "domain": "syroy:sleeping", "value": false },
						{ "test": "bool_property", "domain": "syroy:disturbed", "value": false }
					]},
					"event": "syroy:go_to_sleep"
				},
				{
					"filters": { "all_of": [
					{ "test": "is_daytime", "value": true },
					{ "test": "bool_property", "domain": "syroy:sleeping", "value": true }
					]},
					"event": "syroy:wake_up"
				}
				]
			}							
		},

		"events": {
			"minecraft:entity_spawned": {
				"randomize": [
					{
						"weight": 5,
						"add": {
							"component_groups": ["syroy:wombat_baby", "syroy:wombat_wild"]
						}
					},
					{
						"weight": 95,
						"add": {
							"component_groups": ["syroy:wombat_adult", "syroy:wombat_wild"]
						}
					}
				]
			},
			"minecraft:entity_born": {
				"sequence": [
					{
						"filters": { "test": "is_tamed" },
						"add": { "component_groups": ["syroy:wombat_baby", "syroy:wombat_tame"] }
					},
					{
						"filters": { "test": "is_tamed", "value": false },
						"add": { "component_groups": ["syroy:wombat_baby", "syroy:wombat_wild"] }
					}
				]
			},
			"minecraft:ageable_grow_up": {
				"remove": {
					"component_groups": ["syroy:wombat_baby"]
				},
				"add": {
					"component_groups": ["syroy:wombat_adult"]
				}
			},
			"minecraft:on_tame": {
				"remove": {
					"component_groups": ["syroy:wombat_wild"]
				},
				"add": {
					"component_groups": ["syroy:wombat_tame"]
				}
			},
			"syroy:go_to_sleep": {
				"add": { "component_groups": ["syroy:wombat_sleeping"] },
				"set_property": { "syroy:sleeping": true }
			},
			"syroy:wake_up": {
				"remove": { "component_groups": ["syroy:wombat_sleeping"] },
				"set_property": { "syroy:sleeping": false }
			},
			"syroy:disturbed": {
				"remove": { "component_groups": ["syroy:wombat_sleeping"] },
				"add": { "component_groups": ["syroy:wombat_alert"] },
				"set_property": { "syroy:sleeping": false, "syroy:disturbed": true }
			},
			"syroy:calm_down": {
				"remove": { "component_groups": ["syroy:wombat_alert"] },
				"set_property": { "syroy:disturbed": false }
			}						
		}		
	}
}